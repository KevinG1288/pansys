# Copia este archivo como .env y completa los valores reales.
# Nunca subas el archivo .env a Git.
PORT=3000
DB_HOST=localhost
DB_USER=pansys_user
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=pansys_db
JWT_SECRET=genera_una_cadena_larga_y_aleatoria

# ---------------------------------------------------------------------------------------
# Modo demo (opcional; ver DEMO.md en la raíz del repositorio). Por defecto, desactivado.
# No hace falta escribirlo aquí: lo recomendable es definirlo solo en la terminal de la demo.
# ---------------------------------------------------------------------------------------
# PANSYS_MODO_DEMO=1        -> el servidor se niega a arrancar si DB_NAME no es exactamente
#                              pansys_test o si la conexión real apunta a otra base
# PANSYS_SERVIR_FRONTEND=1  -> Express sirve frontend/build (un solo origen: interfaz y API
#                              en el mismo puerto). Compílalo antes con:
#                              cd frontend && node scripts/compilar-demo.js
# En la demo usa un JWT_SECRET distinto del de producción y, si es posible, un usuario de
# MySQL con permisos solo sobre pansys_test.
