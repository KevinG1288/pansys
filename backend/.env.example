# Copia este archivo como .env (DESARROLLO) y completa los valores. Nunca subas .env a Git.
#
# Dos archivos, nunca mezclados (src/config/entorno.js carga UNO solo):
#   backend/.env             desarrollo, demo y pruebas: npm start / npm run dev
#   backend/.env.produccion  producción: SOLO con npm run start:produccion (argumento
#                            --entorno=produccion; no se puede activar con una variable)
# Los dos están excluidos de Git (.gitignore: .env y .env.*).
PORT=3000
DB_HOST=localhost
DB_USER=pansys_user
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=pansys_test
# JWT_SECRET: secreto de firma de las sesiones. Genérelo con un generador criptográficamente seguro:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En producción (--entorno=produccion) el servidor no arranca si falta, tiene menos de 32
# caracteres, espacios en los extremos, pocos caracteres distintos o un valor de ejemplo como este.
JWT_SECRET=genera_una_cadena_larga_y_aleatoria

# ---------------------------------------------------------------------------------------
# Base de producción (solo en .env.produccion). El servidor NO arranca contra pansys_db salvo que
# se cumplan A LA VEZ: --entorno=produccion, NODE_ENV=production y
# PANSYS_AUTORIZAR_BASE_PRODUCCION=pansys_db, sin modo demo. NODE_ENV=production sin
# --entorno=produccion también detiene el arranque.
# ---------------------------------------------------------------------------------------
# NODE_ENV=production
# DB_NAME=pansys_db
# PANSYS_AUTORIZAR_BASE_PRODUCCION=pansys_db
# ---------------------------------------------------------------------------------------
# Modo demo (opcional; ver DEMO.md en la raíz del repositorio). Por defecto, desactivado.
# No hace falta escribirlo aquí: lo recomendable es definirlo solo en la terminal de la demo.
# ---------------------------------------------------------------------------------------
# PANSYS_MODO_DEMO=1        -> el servidor se niega a arrancar si DB_NAME no es exactamente
#                              pansys_test o si la conexión real apunta a otra base
# PANSYS_SERVIR_FRONTEND=1  -> Express sirve frontend/build (un solo origen: interfaz y API
#                              en el mismo puerto). Compílalo antes con:
#                              cd frontend && node scripts/compilar-demo.js
# En la demo usa un JWT_SECRET distinto del de producción y, si es posible, un usuario de
# MySQL con permisos solo sobre pansys_test.

# ---------------------------------------------------------------------------------------
# Restablecimiento de contraseña por correo (opcional). Sin estas variables, sus endpoints
# responden 503 y el resto de la aplicación funciona igual. Requiere el SQL 005 en la base.
# ---------------------------------------------------------------------------------------
# PANSYS_URL_PUBLICA=https://pansys.ejemplo   -> ÚNICO origen de los enlaces (nunca el Host de
#                                                la petición); solo protocolo, host y puerto
# PANSYS_PERMITIR_HTTP_LOCAL=1                -> admite http://localhost fuera de producción
#
# PANSYS_CORREO_MODO elige cómo se envía. SIN ESTA VARIABLE EL CORREO ESTÁ DESACTIVADO: una
# configuración PANSYS_SMTP_* antigua, sin modo, no envía nada.
#   desactivado  (por defecto) los endpoints de restablecimiento responden 503
#   json         jsonTransport, sin red: solo con NODE_ENV=test, o fuera de producción con
#                PANSYS_PERMITIR_CORREO_JSON=1 (autorización explícita para un entorno local)
#   mailpit      Mailpit en el propio equipo, sin TLS ni autenticación; nunca en producción
#   smtp         proveedor real, SIEMPRE cifrado
# PANSYS_CORREO_MODO=mailpit
# PANSYS_CORREO_REMITENTE=no-responder@pansys.local   -> obligatoria salvo en desactivado
#
# Modo mailpit:
# PANSYS_SMTP_HOST=localhost                  -> solo localhost, 127.0.0.1 o ::1 (por defecto localhost)
# PANSYS_SMTP_PUERTO=1025                     -> por defecto 1025
#
# Modo smtp (el certificado se valida siempre y se exige TLS 1.2 como mínimo):
# PANSYS_SMTP_HOST=smtp.proveedor.ejemplo
# PANSYS_SMTP_TLS=starttls                    -> starttls (STARTTLS obligatorio, puerto 587 por
#                                                defecto) o implicito (TLS desde el inicio, 465)
# PANSYS_SMTP_PUERTO=587                      -> opcional
# PANSYS_SMTP_USUARIO=cambia_este_usuario     -> opcionales, pero las dos o ninguna; nunca se
# PANSYS_SMTP_CONTRASENA=cambia_esta_clave    -> registran ni aparecen en mensajes de error
#
# SMTP real FUERA de producción (desarrollo, demo, pruebas manuales): exige además, a la vez,
# PANSYS_PERMITIR_SMTP_REAL=1                 -> autorización explícita
# PANSYS_CORREO_DESTINOS_PERMITIDOS=persona@dominio.ejemplo,@otro.ejemplo
#                                             -> lista obligatoria: direcciones exactas (también sus
#                                                subdirecciones persona+x@...) o @dominio completos.
#                                                Cualquier otro destinatario se rechaza sin conexión.
# Sin ellas, el servidor NO arranca. En producción la lista es opcional (si se define, se aplica).
# Al arrancar se muestra una línea «Correo: ...» con el modo, sin usuario, contraseña ni destinos.
#
# PANSYS_SMTP_SOLO_LOCAL ya no se usa: si se define junto con un modo, la configuración se rechaza.
