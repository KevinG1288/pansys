# Plantilla de configuración del frontend para el DESARROLLO local. Cópiala como frontend/.env
# (no se versiona: .gitignore excluye .env y .env.*) y ajústala si cambias los puertos.
#
# Desarrollo (npm start):
#   PORT              puerto del servidor de desarrollo de React (el backend usa el 3000)
#   REACT_APP_API_URL dirección del backend en el propio equipo
#
# Producción y demo de un solo origen: NO hace falta frontend/.env. Compila con
#   node scripts/compilar-demo.js
# que fija REACT_APP_API_URL='/' (la interfaz llama a /api/... en el mismo origen que la sirve),
# desactiva los mapas de código fuente y comprueba que el resultado no contenga direcciones fijas.
#
# Las variables REACT_APP_* quedan incrustadas en el JavaScript publicado: nunca pongas aquí
# contraseñas, tokens ni claves.
PORT=3001
REACT_APP_API_URL=http://localhost:3000
